# shellcheck shell=bash
# shellcheck disable=SC2034  # Vars consumed by Kamal externally.
# Pulls credentials from the sibling infrastructure repo's SOPS files.
# Adjust INFRA path if your checkout layout differs.
INFRA=${INFRA:-../infrastructure}

SHARED=$(sops -d "$INFRA/secrets/shared.enc.yaml")

KAMAL_REGISTRY_PASSWORD=$(printf '%s' "$SHARED" | yq -r '.docker_registry_password')
